<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Xcode adds the generated keys to these. The values come from Example.xcconfig and Local.xcconfig. -->
<plist version="1.0">
<dict>
	<key>CodelloyKey</key>
	<string>$(EXAMPLE_CODELLOY_KEY)</string>
	<key>CodelloyBaseURL</key>
	<string>$(EXAMPLE_CODELLOY_BASE_URL)</string>
	<!-- Lets a development build call a local backend over http. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
